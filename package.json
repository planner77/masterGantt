{
  "name": "mastergantt",
  "version": "0.65.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prepare-standalone-runtime.mjs && npm run build:runtime-tools",
    "start": "node scripts/start-standalone.mjs",
    "version:check": "node scripts/verify-release-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config tests/config/vitest.config.ts",
    "test:e2e": "playwright test --config tests/config/playwright.config.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "build:runtime-tools": "tsc -p tsconfig.runtime-tools.json"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@svar-ui/react-gantt": "2.7.3",
    "better-sqlite3": "13.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vitest": "5.0.0",
    "tsx": "4.23.13"
  }
}
