{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImportPayload",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 }
      },
      "required": ["name", "description"],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "anyOf": [
          { "$ref": "#/definitions/LeafTask" },
          { "$ref": "#/definitions/SummaryTask" }
        ]
      }
    }
  },
  "required": ["schemaVersion", "project", "tasks"],
  "additionalProperties": false,
  "definitions": {
    "LeafTask": {
      "type": "object",
      "properties": {
        "externalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "parentExternalId": { "type": ["string", "null"] },
        "predecessors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "externalId": { "type": "string" },
              "type": { "type": "string", "enum": ["FS", "SS", "FF", "SF"] },
              "lag": { "type": "integer", "minimum": -10000, "maximum": 10000 }
            },
            "required": ["externalId"],
            "additionalProperties": false
          }
        },
        "type": { "type": "string", "enum": ["task", "milestone"] },
        "scheduleMode": { "type": "string", "enum": ["auto", "manual"] },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "duration": { "type": "integer" },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["externalId", "name", "parentExternalId", "predecessors", "type", "start", "duration", "progress"],
      "additionalProperties": false
    },
    "SummaryTask": {
      "type": "object",
      "properties": {
        "externalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "parentExternalId": { "type": ["string", "null"] },
        "predecessors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "externalId": { "type": "string" },
              "type": { "type": "string", "enum": ["FS", "SS", "FF", "SF"] },
              "lag": { "type": "integer", "minimum": -10000, "maximum": 10000 }
            },
            "required": ["externalId"],
            "additionalProperties": false
          }
        },
        "type": { "type": "string", "const": "summary" },
        "scheduleMode": { "type": "string", "const": "auto" },
        "requestedStart": { "type": "null" },
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "duration": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "required": ["externalId", "name", "parentExternalId", "predecessors", "type"],
      "additionalProperties": false
    }
  }
}
