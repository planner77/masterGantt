# 로컬 개발용 설정 예시입니다. 운영 배포 시에는 검토를 마친 운영 환경 설정값을 주입하세요.
NODE_ENV=development
PORT=3000
DATABASE_PATH=.data/mastergantt.sqlite3
APP_BASE_URL=http://127.0.0.1:3000

# 향후 사용을 위해 예약된 배포 입력값입니다. 현재 애플리케이션은 NODE_ENV와 APP_BASE_URL을
# 기준으로 쿠키의 Secure 속성 적용 여부를 결정하며, 아래 세 값은 아직 사용하지 않습니다.
TRUST_PROXY=false
LOG_LEVEL=info

# 운영 환경에서는 APP_BASE_URL에 HTTPS 주소를, DATABASE_PATH에 /data 하위의 정규화된 경로를 지정해야 합니다.

# Docker Compose에서 사용하는 입력값이며 애플리케이션 비밀정보가 아닙니다. 배포 셸 또는 접근 권한이
# 제한된 Compose 환경변수 파일에서 덮어쓰세요. 아래 기본값은 로컬 사용을 위한 예시입니다.
IMAGE_NAME=mastergantt:local
IMAGE_VERSION=local
HOST_PORT=3000
MASTERGANTT_VOLUME_NAME=mastergantt-data

# Compose 파일은 deploy/compose.yml로 이동했습니다. 항상 --env-file .env를 명시하세요.
# 신규 설치용 예시입니다. 기존 배포에서는 현재 컨테이너의 com.docker.compose.project 레이블 값으로 변경하세요.
# 동일한 /data 볼륨에 새 프로젝트의 두 번째 앱 인스턴스를 실행하지 마세요.
COMPOSE_PROJECT_NAME=mastergantt

# 내부망 HTTP를 명시적으로 허용할 때만 true. 빈 값/오타는 시작 오류다.
# APP_BASE_URL=http://192.168.10.20:8080
# HTTPS 배포에서는 true여도 Secure 쿠키를 유지한다.
ALLOW_INSECURE_HTTP=false
