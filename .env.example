# Local development example. Inject reviewed production values at deployment.
NODE_ENV=development
PORT=3000
DATABASE_PATH=.data/mastergantt.sqlite3
APP_BASE_URL=http://127.0.0.1:3000

# Reserved for later authorization/deployment work; W04 does not consume these yet.
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false
LOG_LEVEL=info

# Production requires an HTTPS APP_BASE_URL and a canonical DATABASE_PATH below /data.
