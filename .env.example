# Local development example. Inject reviewed production values at deployment.
NODE_ENV=development
PORT=3000
DATABASE_PATH=.data/mastergantt.sqlite3
APP_BASE_URL=http://127.0.0.1:3000

# Reserved deployment inputs; the current application derives secure Cookie behavior
# from NODE_ENV and APP_BASE_URL and does not consume these three values yet.
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false
LOG_LEVEL=info

# Production requires an HTTPS APP_BASE_URL and a canonical DATABASE_PATH below /data.

# Docker Compose inputs, not application secrets. Override in a deployment shell or
# access-controlled Compose environment file; these defaults are safe local names.
IMAGE_NAME=mastergantt:local
IMAGE_VERSION=local
HOST_PORT=3000
MASTERGANTT_VOLUME_NAME=mastergantt-data
